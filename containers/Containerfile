# ComfyUI -- one definition, two pinned images.
#
# The ONLY difference between the cuda and rocm images is the wheel index the
# lockfile was compiled against, plus a couple of apt packages. Neither image
# uses a vendor base: torch's cu130 / rocm7.1 wheels bundle their own userspace
# runtime, and the kernel driver arrives from the host (CDI for NVIDIA,
# /dev/kfd + /dev/dri for AMD).
#
# Build inputs are generated artifacts only -- manifest/nodes.lock.json and
# env/<backend>/requirements.txt. comfyui.toml is never read here.
#
# DELIBERATELY SINGLE-STAGE. A builder/runtime split would buy nothing: both
# stages share this base, and the runtime needs git anyway for cm-cli
# inspection. It would cost a great deal -- /opt/comfyui is ~10GB once the
# accelerator wheels land, so a cross-stage COPY duplicates it, and any
# subsequent `chmod -R` rewrites every file's metadata and forces overlayfs to
# copy up the whole tree AGAIN. Three copies of 10GB is how this ran the CI
# microVM out of disk. One stage, modes set in the same layer that creates the
# files.

# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE=docker.io/library/ubuntu:24.04
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.1

FROM ${UV_IMAGE} AS uv

FROM ${BASE_IMAGE}

ARG BACKEND=cuda
ARG PYTHON_VERSION=3.12
ARG BACKEND_APT=""
ARG COMFY_UID=1000
ARG COMFY_GID=1000
ARG RENDER_GID=105
ARG VIDEO_GID=39

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_NO_CACHE=1 \
    VIRTUAL_ENV=/opt/comfyui/.venv
# Deliberately NOT UV_LINK_MODE=copy. uv unpacks each wheel under TMPDIR and
# then materialises it into the venv; on one filesystem the default hardlink
# path is nearly free, while `copy` duplicates every byte. The ROCm torch wheel
# alone unpacks to roughly 13GB, so copy mode doubled peak usage and exhausted
# the build volume DURING EXTRACTION -- before any post-install pruning could
# possibly run.

LABEL org.opencontainers.image.title="comfyui-${BACKEND}" \
      org.opencontainers.image.description="ComfyUI, ${BACKEND} backend, pinned environment" \
      org.opencontainers.image.source="https://github.com/lazypower/comfyui-runtime"

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential ca-certificates git libgl1 libglib2.0-0 tini ${BACKEND_APT} \
 && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv

# The distro ships no python; the interpreter is uv-managed so its version is
# pinned by the manifest rather than by Ubuntu's release cycle. Put it on PATH
# so build steps and the healthcheck can reach it without knowing where uv
# parked it.
RUN uv python install ${PYTHON_VERSION} \
 && ln -sf "$(uv python find ${PYTHON_VERSION})" /usr/local/bin/python3 \
 && python3 --version

# --- accounts ---------------------------------------------------------------
# The service account owns NOTHING under /opt -- that is what makes the
# production environment immutable at runtime rather than merely by convention.
#
# ubuntu:24.04 ships a default `ubuntu` user squatting on uid/gid 1000, so evict
# whoever holds the requested ids first. The uid must match the owner of the
# host's /var/mnt/diffusion tree, which is why it stays a build arg.
RUN if getent passwd ${COMFY_UID} >/dev/null; then \
        userdel -f "$(getent passwd ${COMFY_UID} | cut -d: -f1)"; \
    fi \
 && if getent group ${COMFY_GID} >/dev/null; then \
        groupdel "$(getent group ${COMFY_GID} | cut -d: -f1)" 2>/dev/null || true; \
    fi \
 && groupadd -g ${COMFY_GID} comfy \
 && useradd -u ${COMFY_UID} -g ${COMFY_GID} -M -d /var/mnt/diffusion -s /usr/sbin/nologin comfy \
 && groupadd -g ${RENDER_GID} -f render \
 && groupadd -g ${VIDEO_GID}  -f video \
 && usermod -aG render,video comfy
# GPU device access: /dev/kfd and /dev/dri/renderD128 are owned by render/video
# on the host, so passing --device is not enough if the service account is in
# neither group. These GIDs are Fedora's (Bazzite, CoreOS). Rootless podman can
# instead rely on --group-add keep-groups.

# --- application ------------------------------------------------------------
WORKDIR /opt/comfyui

COPY manifest/nodes.lock.json          /build/manifest/nodes.lock.json
COPY scripts/pin.py                    /build/scripts/pin.py
COPY env/${BACKEND}/requirements.txt   /build/requirements.txt

# EVERYTHING THAT TOUCHES /opt/comfyui HAPPENS IN THIS ONE LAYER.
#
# Not stylistic. `chown -R` and `chmod -R` rewrite every file's metadata, so
# running either in a later layer makes overlayfs copy up the whole tree --
# shipping a second complete copy of the ~3.3GB venv that every host then pulls
# and stores for nothing. Deleting files later is equally futile: it stacks
# whiteouts on top of bytes that remain in the layer below. Sources, install,
# prune, cleanup and ownership therefore all land together.
#
# `uv pip sync` installs exactly the locked set and REMOVES anything not in it,
# so the venv cannot drift from the manifest. --index-strategy must match the
# one used to compile: the lockfile carries the index URLs but not the
# strategy, and the backend indexes shadow a handful of PyPI packages
# (certifi, filelock, ...) at older versions. --require-hashes turns the
# recorded hashes into an enforced check. The `import torch` is the guard on
# pruning -- if a pruned package turns out to be a DT_NEEDED of
# libtorch_cuda.so, this build fails rather than the GPU host at 2am.
RUN python3 /build/scripts/pin.py fetch /opt/comfyui \
 && uv venv --python ${PYTHON_VERSION} /opt/comfyui/.venv \
 && uv pip sync \
      --python /opt/comfyui/.venv/bin/python \
      --index-strategy unsafe-best-match \
      --require-hashes \
      /build/requirements.txt \
 && python3 /build/scripts/pin.py prune ${BACKEND} /opt/comfyui/.venv \
 && /opt/comfyui/.venv/bin/python -c \
      "import torch; print('torch', torch.__version__, 'imports after prune')" \
 && apt-get purge -y --auto-remove build-essential \
 && find /opt/comfyui -maxdepth 3 -name .git -type d -prune -exec rm -rf {} + \
 && find /opt/comfyui -name '__pycache__' -type d -prune -exec rm -rf {} + \
 && rm -rf /build \
 && chown -R comfy:comfy /opt/comfyui \
 && chown -R root:root /opt/comfyui/.venv \
 && chmod -R a-w /opt/comfyui/.venv \
 && du -sh /opt/comfyui/.venv /opt/comfyui

# Small files only, so these layers stay in the kilobytes. They land after the
# ownership pass and stay root-owned, which is correct -- they are read-only
# configuration, not state.
COPY containers/extra_model_paths.yaml /opt/comfyui/extra_model_paths.yaml
COPY manifest/nodes.lock.json          /opt/comfyui/nodes.lock.json
COPY --chmod=0755 containers/entrypoint.sh /usr/local/bin/entrypoint

# THE BOUNDARY IS THE VENV, NOT THE TREE.
#
# The dependency graph must never move: /opt/comfyui/.venv is root-owned and
# unwritable, and the service account is not root. No node, and no Manager
# action, can pip-install into a running container. That is the whole point --
# it is what stops an install accreting dependencies until it can no longer be
# reproduced.
#
# The rest of the tree is writable by the service account, because ComfyUI's
# ecosystem writes into it in several places AT IMPORT TIME and a read-only
# tree does not merely lose settings, it stops nodes loading:
#   ComfyUI-Manager        creates custom_nodes/ComfyUI-Manager/default/
#   ComfyUI-Custom-Scripts os.makedirs(web/extensions/pysssss)  (pysssss.py)
# Sealing directories one at a time as each new node trips over them is a game
# with no end state; the venv is the line that actually matters.
#
# Determinism survives because those writes land in the container's upper layer
# and vanish on restart, so the image still completely describes the system
# every time it starts. Drift cannot accumulate across restarts, which is the
# failure this design exists to prevent.

ENV COMFY_BACKEND=${BACKEND} \
    COMFY_ROOT=/opt/comfyui \
    COMFY_STATE=/var/mnt/diffusion \
    PATH="/opt/comfyui/.venv/bin:${PATH}" \
    HF_HOME=/var/mnt/diffusion/cache/huggingface \
    TORCH_HOME=/var/mnt/diffusion/cache/torch \
    XDG_CACHE_HOME=/var/mnt/diffusion/cache/xdg \
    MPLCONFIGDIR=/var/mnt/diffusion/cache/matplotlib
# Declared here as well as exported by the entrypoint so the redirection is a
# property of the IMAGE, true for `docker run --entrypoint ...` too. Anything
# that downloads a model must not be able to fill the container's upper layer
# just because it was invoked without the entrypoint. The entrypoint still
# recomputes them from COMFY_STATE and creates the directories.

# Deliberately NO `VOLUME /var/mnt/diffusion`. A declared volume gets an
# anonymous volume auto-created when the operator forgets to bind-mount, which
# would satisfy the entrypoint's `mountpoint` check and silently write a model
# tree into a volume nobody knows the name of. Leaving it undeclared makes the
# unmounted case a plain directory, which fails the check loudly. That is the
# point.

USER comfy
EXPOSE 8188

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8188/system_stats',timeout=4).status==200 else 1)"

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint"]
CMD ["--listen", "0.0.0.0", "--port", "8188"]
